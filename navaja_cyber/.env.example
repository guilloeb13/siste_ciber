# =============================================================================
# NavajaCyber Configuration - COPY TO .env AND CUSTOMIZE
# =============================================================================

# -----------------------------------------------------------------------------
# LEGAL DISCLAIMER
# -----------------------------------------------------------------------------
# USO AUTORIZADO ÚNICAMENTE. Este software está diseñado para defensa,
# capacitación y análisis forense. Cualquier uso no autorizado, intento de
# intrusión o explotación contra sistemas externos sin permiso es ilegal.
# -----------------------------------------------------------------------------

# Application Settings
APP_NAME=NavajaCyber
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Security Settings
SECRET_KEY=change-this-to-a-secure-random-string-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
ALLOWED_HOSTS=localhost,127.0.0.1

# Rate Limiting (requests per minute)
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_ANALYSIS=10
RATE_LIMIT_SCAN=5

# PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://navaja:navaja_secret@localhost:5432/navaja_cyber
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Cache & PubSub
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300

# MinIO/S3 Storage (for forensic evidence)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_EVIDENCE=navaja-evidence
MINIO_BUCKET_REPORTS=navaja-reports
MINIO_SECURE=false

# Elasticsearch (optional, for log analysis)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_LOGS=navaja-logs
ELASTICSEARCH_INDEX_FINDINGS=navaja-findings

# InfluxDB (optional, for time-series metrics)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-influxdb-token
INFLUXDB_ORG=navaja
INFLUXDB_BUCKET=metrics

# Agent Configuration
AGENT_ID=
AGENT_TOKEN=
BACKEND_URL=http://localhost:8000
METRIC_INTERVAL=30
HEALTH_CHECK_INTERVAL=60

# Analysis Module Settings
ANALYSIS_TIMEOUT=300
BANDIT_CONFIDENCE=MEDIUM
SEMGREP_RULES_PATH=/etc/navaja/semgrep-rules
MAX_REPO_SIZE_MB=500

# Forensic Module Settings
FORENSIC_HASH_ALGORITHM=sha256
EVIDENCE_RETENTION_DAYS=90
CHAIN_OF_CUSTODY_ENABLED=true

# CTF Module Settings
CTF_DOCKER_NETWORK=navaja-ctf-net
CTF_CHALLENGE_TIMEOUT=3600
CTF_MAX_CONCURRENT_CHALLENGES=50
CTF_FLAG_PREFIX=NAVAJA{
CTF_FLAG_SUFFIX=}

# Database Security Analysis
DB_ANALYSIS_TIMEOUT=120
DB_ANALYSIS_SAMPLE_SIZE=1000

# Alert Notifications
ALERT_WEBHOOK_URL=
ALERT_SLACK_WEBHOOK=
ALERT_EMAIL_SMTP_HOST=
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_USERNAME=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_FROM=alerts@navajacyber.local
ALERT_EMAIL_TO=security-team@navajacyber.local

# Prometheus Metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# OpenTelemetry (optional)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=navaja-cyber

# Simulation Mode (for testing without real systems)
SIMULATION_MODE=false

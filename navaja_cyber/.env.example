# =============================================================================
# NavajaCyber Configuration - COPY TO .env AND CUSTOMIZE
# =============================================================================

# -----------------------------------------------------------------------------
# LEGAL DISCLAIMER
# -----------------------------------------------------------------------------
# USO AUTORIZADO ÚNICAMENTE. Este software está diseñado para defensa,
# capacitación y análisis forense. Cualquier uso no autorizado, intento de
# intrusión o explotación contra sistemas externos sin permiso es ilegal.
# -----------------------------------------------------------------------------

# Application Settings
APP_NAME=NavajaCyber
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Security Settings
# Generate a unique key: python -c "import secrets; print(secrets.token_urlsafe(48))"
# In production the app REFUSES to start with a default/placeholder or <32 char key.
SECRET_KEY=change-this-to-a-secure-random-string-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
# Hostnames accepted in the Host header (TrustedHostMiddleware). Set to your
# real domain(s) in production. Do NOT use "*".
ALLOWED_HOSTS=localhost,127.0.0.1
# Browser origins allowed by CORS. MUST be full origins (scheme://host:port).
# Empty = no cross-origin browser access. Never combine "*" with credentials.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional shared secret required to enroll a monitoring agent (recommended in
# production). When empty, agent registration is open (development only).
AGENT_ENROLLMENT_TOKEN=
# When set, repository scans by local path are restricted to this base directory
# (prevents scanning arbitrary paths such as /etc). Leave empty to disable
# local-path scanning entirely.
SCAN_BASE_DIR=

# Rate Limiting (requests per minute) — enforced via slowapi
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_ANALYSIS=10
RATE_LIMIT_SCAN=5
RATE_LIMIT_AUTH=5           # login / token endpoint
RATE_LIMIT_REGISTER=10     # user & agent registration
RATE_LIMIT_SUBMIT=30       # CTF flag submission
# Shared counter store for multi-worker/instance deployments (empty = in-memory).
# e.g. redis://localhost:6379/1
RATE_LIMIT_STORAGE_URI=
# Only enable behind a trusted reverse proxy that sets X-Forwarded-For.
RATE_LIMIT_TRUST_FORWARDED=false

# Account Lockout (per-username failed-login throttle; requires Redis)
LOCKOUT_ENABLED=true
LOCKOUT_MAX_ATTEMPTS=10
LOCKOUT_WINDOW_SECONDS=900

# PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://navaja:navaja_secret@localhost:5432/navaja_cyber
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Cache & PubSub
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300

# MinIO/S3 Storage (for forensic evidence)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_EVIDENCE=navaja-evidence
MINIO_BUCKET_REPORTS=navaja-reports
MINIO_SECURE=false

# Elasticsearch (optional, for log analysis)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_LOGS=navaja-logs
ELASTICSEARCH_INDEX_FINDINGS=navaja-findings

# InfluxDB (optional, for time-series metrics)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-influxdb-token
INFLUXDB_ORG=navaja
INFLUXDB_BUCKET=metrics

# Agent Configuration
AGENT_ID=
AGENT_TOKEN=
BACKEND_URL=http://localhost:8000
METRIC_INTERVAL=30
HEALTH_CHECK_INTERVAL=60

# Analysis Module Settings
ANALYSIS_TIMEOUT=300
BANDIT_CONFIDENCE=MEDIUM
SEMGREP_RULES_PATH=/etc/navaja/semgrep-rules
MAX_REPO_SIZE_MB=500

# Forensic Module Settings
FORENSIC_HASH_ALGORITHM=sha256
EVIDENCE_RETENTION_DAYS=90
CHAIN_OF_CUSTODY_ENABLED=true
# Max size (MB) for a single uploaded evidence file (streamed to disk).
EVIDENCE_MAX_MB=2048

# CTF Module Settings
# Dedicated/isolated Docker endpoint for launching challenges (rootless / Sysbox
# / gVisor / remote daemon). Leave empty to use the local socket (DEV ONLY —
# sharing the host root socket with the API is a container-escape risk).
CTF_DOCKER_HOST=
CTF_DOCKER_NETWORK=navaja-ctf-net
CTF_CHALLENGE_TIMEOUT=3600
CTF_MAX_CONCURRENT_CHALLENGES=50
CTF_FLAG_PREFIX=NAVAJA{
CTF_FLAG_SUFFIX=}

# Database Security Analysis
DB_ANALYSIS_TIMEOUT=120
DB_ANALYSIS_SAMPLE_SIZE=1000

# Alert Notifications
ALERT_WEBHOOK_URL=
ALERT_SLACK_WEBHOOK=
ALERT_EMAIL_SMTP_HOST=
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_USERNAME=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_FROM=alerts@navajacyber.local
ALERT_EMAIL_TO=security-team@navajacyber.local

# Prometheus Metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# OpenTelemetry (optional)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=navaja-cyber

# Simulation Mode (for testing without real systems)
SIMULATION_MODE=false
